# Entorno: local | preview | staging | production
APP_ENV=local

# PostgreSQL directo. En producción use credenciales exclusivas y TLS.
POSTGRES_DB=barber_saas
POSTGRES_USER=barber_saas
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL="postgresql://barber_saas:change-me-local-only@127.0.0.1:5432/barber_saas?schema=public"
TEST_DATABASE_URL="postgresql://barber_saas:change-me-local-only@127.0.0.1:5433/barber_saas_test?schema=public"

# API Node y clientes públicos
API_HOST=0.0.0.0
API_PORT=4000
# Active solo si la API está detrás de un proxy confiable que reemplaza
# X-Forwarded-For (por ejemplo, Nginx en la VPS).
API_TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
MOBILE_RESET_URL=barbersaas://reset-password
MOBILE_INVITATION_URL=barbersaas://accept-invitation

# Protección por IP para creación de cuentas y reenvío de OTP.
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_RESEND_RATE_LIMIT_MAX=5

# Panel interno: solo estas cuentas verificadas pueden solicitar el OTP de acceso.
# Separe varios correos con coma. ADMIN_EMAIL se mantiene como alternativa heredada.
PLATFORM_ADMIN_EMAILS=operaciones@example.com

# SMTP. Mailpit usa 1025 localmente; en producción configure un proveedor real.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@example.local
SMTP_USER=
SMTP_PASSWORD=

PUBLIC_WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=barbersaas
