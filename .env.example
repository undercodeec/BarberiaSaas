# Entorno: local | preview | staging | production
APP_ENV=local

# PostgreSQL directo. En producción use credenciales exclusivas y TLS.
POSTGRES_DB=barber_saas
POSTGRES_USER=barber_saas
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL="postgresql://barber_saas:change-me-local-only@127.0.0.1:5432/barber_saas?schema=public"

# Firebase Cloud Messaging directo. La clave privada vive sólo en el servidor.
FCM_SERVICE_ACCOUNT_FILE=apps/api/.secrets/fcm-service-account.json
FCM_PROJECT_ID=
TEST_DATABASE_URL="postgresql://barber_saas:change-me-local-only@127.0.0.1:5433/barber_saas_test?schema=public"

# API Node y clientes públicos
API_HOST=0.0.0.0
API_PORT=4000
# Active solo si la API está detrás de un proxy confiable que reemplaza
# X-Forwarded-For (por ejemplo, Nginx en la VPS).
API_TRUST_PROXY=false
# Si API_TRUST_PROXY=true fuera de local, indique las IP/CIDR del proxy que
# reemplaza X-Forwarded-For. Nunca use true sin restringir el proxy confiable.
API_TRUSTED_PROXY_IPS=
# En producción use solo orígenes HTTPS exactos, sin rutas ni comodines.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_APP_ENV=local
# Obligatorio fuera de local. Separe varios hosts con coma y no incluya protocolo.
EXPO_PUBLIC_API_ALLOWED_HOSTS=
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
MOBILE_RESET_URL=barbersaas://reset-password
MOBILE_INVITATION_URL=https://reservas.navacloud.app/accept-invitation

# Protección por IP para creación de cuentas y reenvío de OTP.
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_RESEND_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_RECOVER_RATE_LIMIT_MAX=5

# Google Maps. Esta clave es exclusiva del backend y debe restringirse a la IP
# de la VPS y a Places API (New) + Geocoding API.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_RATE_LIMIT_WINDOW_SECONDS=60
GOOGLE_MAPS_RATE_LIMIT_MAX=60

# PayPhone. Clave de 32 bytes codificada en base64, exclusiva del servidor.
# Generela con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No copie Token ni StoreID de los negocios a este archivo.
PAYPHONE_CREDENTIALS_ENCRYPTION_KEY=

# Cobros de suscripciones Nava mediante PayPhone Boton WEB. Esta clave debe ser
# distinta de PAYPHONE_CREDENTIALS_ENCRYPTION_KEY. Los Token/StoreId se cifran
# en PlatformPaymentConfiguration y nunca se escriben aquí.
PLATFORM_PAYMENTS_ENABLED=false
PLATFORM_PAYPHONE_CREDENTIALS_ENCRYPTION_KEY=
# URL pública base del checkout; genera responseUrl y cancellationUrl de PayPhone.
PLATFORM_CHECKOUT_URL=https://navacloud.app/checkout
# URL pública de la app Android, por ejemplo https://play.google.com/store/apps/details?id=...
# Déjela vacía hasta publicar Nava en Google Play.
NEXT_PUBLIC_PLAY_STORE_URL=
# Opcional: lista de IPs del webhook de PayPhone, separadas por comas. El
# webhook queda deshabilitado si está vacío y nunca autoriza un pago.
PLATFORM_PAYPHONE_WEBHOOK_ALLOWED_IPS=
PLATFORM_LOGIN_RATE_LIMIT_MAX=5
PLATFORM_FOUNDER_PROMOTION_CODE=
PLATFORM_MARKETING_POLICY_VERSION=2026-08-23
PLATFORM_PRIVACY_POLICY_VERSION=2026-08-23
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Definir solo después de aprobación comercial/tributaria (0 significa 0%).
PLATFORM_SUBSCRIPTION_TAX_BASIS_POINTS=
PLATFORM_SUBSCRIPTION_TERMS_VERSION=

# Facturación electrónica SRI propia (Nava -> negocio suscriptor). Nava es la
# marca/producto; la razón social y RUC del emisor se configuran sólo en el
# servidor. Nunca introduzca certificados de las barberías. Empiece en test;
# producción requiere ambas banderas explícitas y un .p12 fuera del repositorio.
SRI_EMISSION_ENABLED=false
SRI_ENV=test
SRI_PRODUCTION_ENABLED=false
SRI_ISSUER_RUC=RUC_EMISOR_DE_13_DIGITOS
SRI_ISSUER_LEGAL_NAME=RAZON_SOCIAL_FISCAL_REAL
SRI_ISSUER_TRADE_NAME=Nava
SRI_MAIN_ADDRESS=
SRI_ESTABLISHMENT_CODE=001
SRI_EMISSION_POINT_CODE=001
SRI_ACCOUNTING_REQUIRED=NO
SRI_PAYMENT_METHOD_CODE=
SRI_TAX_REGIME=GENERAL
# Deben ser validados con el contador/SRI antes de activar emisión.
SRI_TAX_BASIS_POINTS=
SRI_TAX_CODE=
SRI_TAX_PERCENTAGE_CODE=
SRI_CERTIFICATE_PATH=
SRI_CERTIFICATE_PASSWORD=
SRI_AUTHORIZATION_DELAY_SECONDS=15
SRI_MAX_ATTEMPTS=6


# Valores públicos/restringidos usados al compilar los clientes. En EAS deben
# configurarse por entorno; no reutilice la clave privada del servidor.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Panel interno: solo estas cuentas verificadas pueden solicitar el OTP de acceso.
# Separe varios correos con coma. ADMIN_EMAIL se mantiene como alternativa heredada.
PLATFORM_ADMIN_EMAILS=operaciones@example.com
# Hash scrypt$32768$8$1$ de la contraseña bootstrap del panel, distinta de la
# contraseña de la cuenta Nava del mismo correo; nunca guarde la clave en texto plano.
# Genérelo con: pnpm --filter @barber-saas/api password:hash
PLATFORM_ADMIN_PASSWORD_HASH=
# Habilítelo solo para el desarrollo local del panel; manténgalo en false en otros entornos.
PLATFORM_DEVELOPMENT_BYPASS=false

# SMTP. Mailpit usa 1025 localmente; en producción configure un proveedor real.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@example.local
SMTP_USER=
SMTP_PASSWORD=

PUBLIC_WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=barbersaas
