# Entorno: local | preview | staging | production
APP_ENV=local

# Variables públicas. Use únicamente la clave anon/publishable de Supabase.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Esta variable es exclusivamente de servidor y nunca debe usar prefijo público.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

PUBLIC_WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=barbersaas
NOTIFICATION_PROVIDER=console

