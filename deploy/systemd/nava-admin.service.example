[Unit]
Description=Nava platform administration console
After=network-online.target nava-api.service
Wants=network-online.target

[Service]
Type=simple
User=nava
Group=nava
WorkingDirectory=/opt/nava/app/apps/admin
Environment=NODE_ENV=production
Environment=PORT=3001
# Evita Corepack/pnpm al arrancar: ProtectHome bloquea su caché bajo /home/nava.
ExecStart=/usr/bin/node /opt/nava/app/apps/admin/node_modules/next/dist/bin/next start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nava/app/apps/admin/.next

[Install]
WantedBy=multi-user.target
