[Unit]
Description=Nava platform administration console
After=network-online.target nava-api.service
Wants=network-online.target

[Service]
Type=simple
User=nava
Group=nava
WorkingDirectory=/opt/nava/app
Environment=NODE_ENV=production
ExecStart=/usr/bin/pnpm --filter @barber-saas/admin start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nava/app/apps/admin/.next

[Install]
WantedBy=multi-user.target
