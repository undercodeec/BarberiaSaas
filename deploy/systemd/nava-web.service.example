[Unit]
Description=Nava public booking website
After=network-online.target nava-api.service
Wants=network-online.target

[Service]
Type=simple
User=nava
Group=nava
WorkingDirectory=/opt/nava/app/apps/web
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/nava/frontend.env
ExecStart=/usr/bin/node /opt/nava/app/apps/web/node_modules/next/dist/bin/next start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nava/app/apps/web/.next

[Install]
WantedBy=multi-user.target
