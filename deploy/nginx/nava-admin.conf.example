server {
    listen 80;
    server_name admin.navacloud.app;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name admin.navacloud.app;

    # Sustituir por las rutas administradas por Certbot en el servidor.
    ssl_certificate /etc/letsencrypt/live/admin.navacloud.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.navacloud.app/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        include proxy_params;
    }
}
