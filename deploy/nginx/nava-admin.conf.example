server {
    listen 443 ssl http2;
    server_name admin.navacloud.app;

    # Sustituir por las rutas administradas por Certbot en el servidor.
    ssl_certificate /etc/letsencrypt/live/admin.navacloud.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.navacloud.app/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
