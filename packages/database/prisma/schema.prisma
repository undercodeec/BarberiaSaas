model AppNotification {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  appointmentId  String?             @map("appointment_id") @db.Uuid
  type           AppNotificationType
  title          String              @db.VarChar(160)
  body           String              @db.VarChar(500)
  data           Json                @default("{}")
  readAt         DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("app_notifications")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model PublicBookingAccess {
  id                   String      @id @default(uuid()) @db.Uuid
  appointmentId        String      @unique @map("appointment_id") @db.Uuid
  verificationCodeHash String      @map("verification_code_hash") @db.Char(64)
  verificationAttempts Int         @default(0) @map("verification_attempts")
  managementTokenHash  String?     @unique @map("management_token_hash") @db.Char(64)
  reminderTokenHash    String?     @unique @map("reminder_token_hash") @db.Char(64)
  verifiedAt           DateTime?   @map("verified_at") @db.Timestamptz(3)
  managementExpiresAt  DateTime?   @map("management_expires_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  appointment          Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([verifiedAt, managementExpiresAt])
  @@map("public_booking_access")
}

model PaymentAttempt {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  locationId            String              @map("location_id") @db.Uuid
  appointmentId         String              @map("appointment_id") @db.Uuid
  provider              String              @default("payphone") @db.VarChar(40)
  clientTransactionId   String              @unique @map("client_transaction_id") @db.VarChar(15)
  providerTransactionId String?             @unique @map("provider_transaction_id") @db.VarChar(80)
  storeId               String              @map("store_id") @db.VarChar(160)
  amountCents           Int                 @map("amount_cents")
  currencyCode          String              @default("USD") @map("currency_code") @db.Char(3)
  paymentUrl            String?             @map("payment_url") @db.Text
  status                OnlinePaymentStatus @default(PENDING)
  expiresAt             DateTime            @map("expires_at") @db.Timestamptz(3)
  approvedAt            DateTime?           @map("approved_at") @db.Timestamptz(3)
  providerPayload       Json?               @map("provider_payload")
  manuallyConfirmedAt   DateTime?           @map("manually_confirmed_at") @db.Timestamptz(3)
  manuallyConfirmedByUserId String?          @map("manually_confirmed_by_user_id") @db.Uuid
  manualConfirmationNote String?             @map("manual_confirmation_note") @db.VarChar(500)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location              Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  appointment           Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  manuallyConfirmedBy    User?               @relation("PayphoneManualConfirmation", fields: [manuallyConfirmedByUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId, createdAt])
  @@index([organizationId, status, expiresAt])
  @@map("payment_attempts")
}

model AppointmentReview {
  id                       String       @id @default(uuid()) @db.Uuid
  appointmentId            String       @unique @map("appointment_id") @db.Uuid
  organizationId           String       @map("organization_id") @db.Uuid
  locationId               String       @map("location_id") @db.Uuid
  professionalMembershipId String       @map("professional_membership_id") @db.Uuid
  clientName               String       @map("client_name") @db.VarChar(120)
  rating                   Int          @db.SmallInt
  comment                  String?      @db.VarChar(1000)
  isVisible                Boolean      @default(true) @map("is_visible")
  hiddenAt                 DateTime?    @map("hidden_at") @db.Timestamptz(3)
  hiddenByUserId           String?      @map("hidden_by_user_id") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  appointment              Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location                 Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  professional             Membership   @relation(fields: [professionalMembershipId], references: [id], onDelete: Cascade)
  hiddenBy                 User?        @relation("ReviewHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, isVisible, createdAt])
  @@index([professionalMembershipId, isVisible, createdAt])
  @@map("appointment_reviews")
}

model AppointmentService {
  id              String      @id @default(uuid()) @db.Uuid
  appointmentId   String      @map("appointment_id") @db.Uuid
  serviceId       String      @map("service_id") @db.Uuid
  serviceName     String      @map("service_name") @db.VarChar(120)
  durationMinutes Int         @map("duration_minutes")
  priceCents      Int         @map("price_cents")
  sortOrder       Int         @default(0) @map("sort_order")
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

model AppointmentEvent {
  id             BigInt               @id @default(autoincrement())
  organizationId String               @map("organization_id") @db.Uuid
  locationId     String               @map("location_id") @db.Uuid
  appointmentId  String               @map("appointment_id") @db.Uuid
  actorUserId    String?              @map("actor_user_id") @db.Uuid
  type           AppointmentEventType
  payload        Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  appointment    Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor          User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, id])
  @@index([locationId, id])
  @@map("appointment_events")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  locationId     String?      @map("location_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  entityType     String       @map("entity_type") @db.VarChar(80)
  entityId       String       @map("entity_id") @db.Uuid
  action         String       @db.VarChar(80)
  beforeData     Json?        @map("before_data")
  afterData      Json?        @map("after_data")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
