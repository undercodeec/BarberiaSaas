  emissionPointCode            String                   @map("emission_point_code") @db.Char(3)
  sequential                   Int
  accessKey                    String                   @unique @map("access_key") @db.Char(49)
  authorizationNumber          String?                  @map("authorization_number") @db.VarChar(80)
  authorizationDate            DateTime?                @map("authorization_date") @db.Timestamptz(3)
  status                       SriInvoiceStatus         @default(PENDING)
  deliveryStatus               SriInvoiceDeliveryStatus @default(PENDING) @map("delivery_status")
  buyerIdentificationType      String                   @map("buyer_identification_type") @db.Char(2)
  buyerIdentification          String                   @map("buyer_identification") @db.VarChar(20)
  buyerName                    String                   @map("buyer_name") @db.VarChar(300)
  buyerEmail                   String                   @map("buyer_email") @db.VarChar(100)
  buyerAddress                 String?                  @map("buyer_address") @db.VarChar(300)
  buyerPhone                   String?                  @map("buyer_phone") @db.VarChar(24)
  planCode                     String                   @map("plan_code") @db.VarChar(40)
  description                  String                   @db.VarChar(300)
  subtotalCents                Int                      @map("subtotal_cents")
  discountCents                Int                      @default(0) @map("discount_cents")
  taxCents                     Int                      @map("tax_cents")
  taxBasisPoints               Int                      @map("tax_basis_points")
