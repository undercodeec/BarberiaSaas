generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MANAGER
  RECEPTIONIST
  BARBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AppointmentStatus {
  SCHEDULED
  WAITING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum AppointmentPaymentStatus {
  PENDING
  PAID
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CANCELLED
  STATUS_CHANGED
}

enum RegistrationAccountType {
  BUSINESS
  PROFESSIONAL
}

enum OnboardingCollaboratorRole {
  BARBER
  ADMINISTRATOR
  CUSTOM
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  email                  String                   @unique @db.VarChar(254)
  passwordHash           String?                  @map("password_hash") @db.Text
  fullName               String                   @map("full_name") @db.VarChar(120)
  phone                  String?                  @db.VarChar(24)
  profilePhotoData       String?                  @map("profile_photo_data") @db.Text
  profileBio             String?                  @map("profile_bio") @db.VarChar(500)
  emailVerifiedAt        DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  locale                 String                   @default("es") @db.VarChar(10)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationCodes EmailVerificationCode[]
  memberships            Membership[]
  auditLogs              AuditLog[]               @relation("AuditActor")
  invitationsSent        TeamInvitation[]         @relation("InvitationInviter")
  appointmentsCreated    Appointment[]            @relation("AppointmentCreator")
  appointmentsUpdated    Appointment[]            @relation("AppointmentUpdater")
  appointmentEvents      AppointmentEvent[]
  registrationProfile    UserRegistrationProfile?
  onboardingCollaborators OnboardingCollaborator[]
  onboardingServices      OnboardingService[]
  clientsCreated          Client[]                 @relation("ClientCreator")
  clientsUpdated          Client[]                 @relation("ClientUpdater")
  clientNotesCreated      ClientNote[]             @relation("ClientNoteCreator")
  clientLabelsCreated     ClientLabel[]            @relation("ClientLabelCreator")
  clientLabelsUpdated     ClientLabel[]            @relation("ClientLabelUpdater")
  portfolioItems          UserPortfolioItem[]

  @@map("users")
}

model UserPortfolioItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  photoData String   @map("photo_data") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_portfolio_items")
}
model EmailVerificationCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_codes")
}

model PendingRegistration {
  id              String                   @id @default(uuid()) @db.Uuid
  email           String                   @unique @db.VarChar(254)
  fullName        String                   @map("full_name") @db.VarChar(120)
  passwordHash    String                   @map("password_hash") @db.Text
  codeHash        String                   @map("code_hash") @db.Char(64)
  expiresAt       DateTime                 @map("expires_at") @db.Timestamptz(3)
  failedAttempts  Int                      @default(0) @map("failed_attempts")
  lockedUntil     DateTime?                @map("locked_until") @db.Timestamptz(3)
  accountType     RegistrationAccountType? @map("account_type")
  businessName    String?                  @map("business_name") @db.VarChar(120)
  businessNameKey String?                  @unique @map("business_name_key") @db.VarChar(120)
  phone           String?                  @db.VarChar(24)
  phoneKey        String?                  @unique @map("phone_key") @db.VarChar(24)
  countryCode     String?                  @map("country_code") @db.Char(2)
  city            String?                  @db.VarChar(120)
  openingTime     String?                  @map("opening_time") @db.Char(5)
  closingTime     String?                  @map("closing_time") @db.Char(5)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([lockedUntil])
  @@map("pending_registrations")
}

model UserRegistrationProfile {
  userId          String                  @id @map("user_id") @db.Uuid
  accountType     RegistrationAccountType @map("account_type")
  businessName    String                  @map("business_name") @db.VarChar(120)
  businessNameKey String                  @unique @map("business_name_key") @db.VarChar(120)
  countryCode     String                  @map("country_code") @db.Char(2)
  city            String                  @db.VarChar(120)
  addressLine     String?                 @map("address_line") @db.VarChar(240)
  coverImageUri   String?                 @map("cover_image_uri") @db.VarChar(2048)
  description     String?                 @db.VarChar(500)
  facebookUrl     String?                 @map("facebook_url") @db.VarChar(2048)
  instagramUrl    String?                 @map("instagram_url") @db.VarChar(2048)
  openingTime     String                  @map("opening_time") @db.Char(5)
  closingTime     String                  @map("closing_time") @db.Char(5)
  phoneKey        String                  @unique @map("phone_key") @db.VarChar(24)
  onboardingCompletedAt DateTime?         @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_registration_profiles")
}

model OnboardingCollaborator {
  id                    String                     @id @default(uuid()) @db.Uuid
  ownerUserId           String                     @map("owner_user_id") @db.Uuid
  name                  String                     @db.VarChar(120)
  description           String?                    @db.VarChar(500)
  photoUri              String?                    @map("photo_uri") @db.VarChar(2048)
  role                  OnboardingCollaboratorRole
  customRoleName        String?                    @map("custom_role_name") @db.VarChar(80)
  customRoleDescription String?                    @map("custom_role_description") @db.VarChar(500)
  canPerformServices    Boolean                    @default(false) @map("can_perform_services")
  identification        String?                    @db.VarChar(64)
  phone                 String?                    @db.VarChar(24)
  agendaColor           String                     @default("#2464E8") @map("agenda_color") @db.Char(7)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                 User                       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@map("onboarding_collaborators")
}

model OnboardingService {
  id                       String   @id @default(uuid()) @db.Uuid
  ownerUserId              String   @map("owner_user_id") @db.Uuid
  name                     String   @db.VarChar(120)
  description              String?  @db.VarChar(500)
  durationMinutes          Int      @map("duration_minutes")
  priceCents               Int      @map("price_cents")
  priceType                String   @map("price_type") @db.VarChar(16)
  onlineBooking            Boolean  @default(true) @map("online_booking")
  showServiceTime          Boolean  @default(true) @map("show_service_time")
  categoryName             String?  @map("category_name") @db.VarChar(80)
  categoryDescription      String?  @map("category_description") @db.VarChar(500)
  taxName                  String?  @map("tax_name") @db.VarChar(80)
  taxPercentage            Int?     @map("tax_percentage")
  taxAddAtCheckout         Boolean  @default(false) @map("tax_add_at_checkout")
  taxAddAtPurchaseEnd      Boolean  @default(false) @map("tax_add_at_purchase_end")
  imageUri                 String?  @map("image_uri") @db.VarChar(2048)
  agendaColor              String   @map("agenda_color") @db.Char(7)
  downPaymentPercentage    Int      @default(0) @map("down_payment_percentage")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                    User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@map("onboarding_services")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([lastActiveAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(120)
  slug              String             @unique @db.VarChar(80)
  status            OrganizationStatus @default(TRIAL)
  currencyCode      String             @default("USD") @map("currency_code") @db.Char(3)
  defaultTimezone   String             @default("America/Guayaquil") @map("default_timezone") @db.VarChar(64)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)
  locations         Location[]
  memberships       Membership[]
  auditLogs         AuditLog[]
  invitations       TeamInvitation[]
  serviceCategories ServiceCategory[]
  services          Service[]
  scheduleBlocks    ScheduleBlock[]
  appointments      Appointment[]
  appointmentEvents AppointmentEvent[]
  clients           Client[]
  clientLabels      ClientLabel[]
  clientNotes       ClientNote[]

  @@map("organizations")
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId  String?      @map("organization_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  updatedByUserId String       @map("updated_by_user_id") @db.Uuid
  fullName        String       @map("full_name") @db.VarChar(120)
  lastName        String?      @map("last_name") @db.VarChar(120)
  phone           String       @db.VarChar(24)
  email          String?      @db.VarChar(254)
  birthDate      String?      @map("birth_date") @db.Char(10)
  addressLine    String?      @map("address_line") @db.VarChar(240)
  documentNumber String?      @map("document_number") @db.VarChar(64)
  notes          String?      @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("ClientCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy      User         @relation("ClientUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  labels         ClientLabelAssignment[]
  noteEntries    ClientNote[]

  @@index([organizationId, fullName])
  @@index([createdByUserId])
  @@map("clients")
}

model ClientNote {
  id              String        @id @default(uuid()) @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  organizationId  String?       @map("organization_id") @db.Uuid
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  description     String        @db.VarChar(500)
  photoData       String?       @map("photo_data") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy       User          @relation("ClientNoteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdByUserId, createdAt])
  @@map("client_notes")
}
model ClientLabel {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String?                 @map("organization_id") @db.Uuid
  createdByUserId String                  @map("created_by_user_id") @db.Uuid
  updatedByUserId String                  @map("updated_by_user_id") @db.Uuid
  name            String                  @db.VarChar(60)
  color           String                  @db.Char(7)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy       User                    @relation("ClientLabelCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User                    @relation("ClientLabelUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  clients         ClientLabelAssignment[]

  @@index([organizationId, name])
  @@index([createdByUserId, name])
  @@map("client_labels")
}

model ClientLabelAssignment {
  clientId  String      @map("client_id") @db.Uuid
  labelId   String      @map("label_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     ClientLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([clientId, labelId])
  @@index([labelId])
  @@map("client_label_assignments")
}
model Location {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  name                 String                @db.VarChar(120)
  slug                 String                @db.VarChar(80)
  addressLine          String?               @map("address_line") @db.VarChar(240)
  city                 String?               @db.VarChar(120)
  countryCode          String                @default("EC") @map("country_code") @db.Char(2)
  currencyCode         String                @default("USD") @map("currency_code") @db.Char(3)
  timezone             String                @default("America/Guayaquil") @db.VarChar(64)
  phone                String                @db.VarChar(24)
  whatsappPhone        String                @map("whatsapp_phone") @db.VarChar(24)
  email                String?               @db.VarChar(254)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberLocations      MemberLocation[]
  auditLogs            AuditLog[]
  invitations          TeamInvitation[]
  professionalServices ProfessionalService[]
  weeklySchedules      WeeklySchedule[]
  scheduleBlocks       ScheduleBlock[]
  appointments         Appointment[]
  appointmentEvents    AppointmentEvent[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("locations")
}

model Membership {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  role                 MembershipRole
  status               MembershipStatus      @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  memberLocations      MemberLocation[]
  professionalServices ProfessionalService[]
  weeklySchedules      WeeklySchedule[]
  scheduleBlocks       ScheduleBlock[]
  appointments         Appointment[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model MemberLocation {
  membershipId String     @map("membership_id") @db.Uuid
  locationId   String     @map("location_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipId, locationId])
  @@index([locationId])
  @@map("member_locations")
}

model TeamInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  locationId     String           @map("location_id") @db.Uuid
  inviterUserId  String           @map("inviter_user_id") @db.Uuid
  email          String           @db.VarChar(254)
  role           MembershipRole
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  inviter        User             @relation("InvitationInviter", fields: [inviterUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([email, status])
  @@map("team_invitations")
}

model ServiceCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(80)
  sortOrder      Int          @default(0) @map("sort_order")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       Service[]

  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
  @@map("service_categories")
}

model Service {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  categoryId           String?               @map("category_id") @db.Uuid
  name                 String                @db.VarChar(120)
  description          String?               @db.VarChar(500)
  durationMinutes      Int                   @map("duration_minutes")
  priceCents           Int                   @map("price_cents")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category             ServiceCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  professionalServices ProfessionalService[]
  appointmentServices  AppointmentService[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("services")
}

model ProfessionalService {
  membershipId          String     @map("membership_id") @db.Uuid
  serviceId             String     @map("service_id") @db.Uuid
  locationId            String     @map("location_id") @db.Uuid
  customDurationMinutes Int?       @map("custom_duration_minutes")
  customPriceCents      Int?       @map("custom_price_cents")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership            Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service               Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  location              Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipId, serviceId, locationId])
  @@index([serviceId, locationId])
  @@map("professional_services")
}

model WeeklySchedule {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  locationId   String     @map("location_id") @db.Uuid
  weekday      Int
  startMinute  Int        @map("start_minute")
  endMinute    Int        @map("end_minute")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([membershipId, locationId, weekday, startMinute])
  @@index([locationId, weekday])
  @@map("weekly_schedules")
}

model ScheduleBlock {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  membershipId   String       @map("membership_id") @db.Uuid
  locationId     String       @map("location_id") @db.Uuid
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(3)
  reason         String?      @db.VarChar(240)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([membershipId, startsAt, endsAt])
  @@index([locationId, startsAt])
  @@map("schedule_blocks")
}

model CashRegisterSession {
  id                      String             @id @default(uuid()) @db.Uuid
  organizationId          String?            @map("organization_id") @db.Uuid
  ownerUserId             String             @map("owner_user_id") @db.Uuid
  locationId              String?            @map("location_id") @db.Uuid
  responsibleMembershipId String?            @map("responsible_membership_id") @db.Uuid
  responsibleName         String             @map("responsible_name") @db.VarChar(120)
  openingAmountCents      Int                @map("opening_amount_cents")
  status                  CashRegisterStatus @default(OPEN)
  openedAt                DateTime           @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt                DateTime?          @map("closed_at") @db.Timestamptz(3)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, status])
  @@index([ownerUserId, status])
  @@map("cash_register_sessions")
}
model Appointment {
  id                       String               @id @default(uuid()) @db.Uuid
  organizationId           String               @map("organization_id") @db.Uuid
  locationId               String               @map("location_id") @db.Uuid
  professionalMembershipId String               @map("professional_membership_id") @db.Uuid
  clientName               String               @map("client_name") @db.VarChar(120)
  clientPhone              String?              @map("client_phone") @db.VarChar(24)
  clientEmail              String?              @map("client_email") @db.VarChar(254)
  startsAt                 DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt                   DateTime             @map("ends_at") @db.Timestamptz(3)
  status                   AppointmentStatus    @default(SCHEDULED)
  paymentStatus            AppointmentPaymentStatus @default(PENDING) @map("payment_status")
  reservesSlot             Boolean              @default(true) @map("reserves_slot")
  notes                    String?              @db.VarChar(500)
  cancellationReason       String?              @map("cancellation_reason") @db.VarChar(240)
  cancelledAt              DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  createdByUserId          String               @map("created_by_user_id") @db.Uuid
  updatedByUserId          String               @map("updated_by_user_id") @db.Uuid
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization             Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location                 Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  professional             Membership           @relation(fields: [professionalMembershipId], references: [id], onDelete: Restrict)
  createdBy                User                 @relation("AppointmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                User                 @relation("AppointmentUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  services                 AppointmentService[]
  events                   AppointmentEvent[]

  @@index([organizationId, startsAt])
  @@index([locationId, startsAt])
  @@index([professionalMembershipId, startsAt])
  @@map("appointments")
}

model AppointmentService {
  id              String      @id @default(uuid()) @db.Uuid
  appointmentId   String      @map("appointment_id") @db.Uuid
  serviceId       String      @map("service_id") @db.Uuid
  serviceName     String      @map("service_name") @db.VarChar(120)
  durationMinutes Int         @map("duration_minutes")
  priceCents      Int         @map("price_cents")
  sortOrder       Int         @default(0) @map("sort_order")
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

model AppointmentEvent {
  id             BigInt               @id @default(autoincrement())
  organizationId String               @map("organization_id") @db.Uuid
  locationId     String               @map("location_id") @db.Uuid
  appointmentId  String               @map("appointment_id") @db.Uuid
  actorUserId    String               @map("actor_user_id") @db.Uuid
  type           AppointmentEventType
  payload        Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  appointment    Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor          User                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, id])
  @@index([locationId, id])
  @@map("appointment_events")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  locationId     String?      @map("location_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  entityType     String       @map("entity_type") @db.VarChar(80)
  entityId       String       @map("entity_id") @db.Uuid
  action         String       @db.VarChar(80)
  beforeData     Json?        @map("before_data")
  afterData      Json?        @map("after_data")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
