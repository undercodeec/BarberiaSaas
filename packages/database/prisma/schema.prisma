  taxPercentageCode            String                   @map("tax_percentage_code") @db.VarChar(4)
  totalCents                   Int                      @map("total_cents")
  currencyCode                 String                   @default("USD") @map("currency_code") @db.Char(3)
  paymentMethodCode            String                   @map("payment_method_code") @db.Char(2)
  paymentReference             String?                  @map("payment_reference") @db.VarChar(80)
  issuedAt                     DateTime                 @map("issued_at") @db.Timestamptz(3)
  authorizedAt                 DateTime?                @map("authorized_at") @db.Timestamptz(3)
  emailedAt                    DateTime?                @map("emailed_at") @db.Timestamptz(3)
  nextAttemptAt                DateTime?                @map("next_attempt_at") @db.Timestamptz(3)
  attemptCount                 Int                      @default(0) @map("attempt_count")
  processingLockToken          String?                  @map("processing_lock_token") @db.Uuid
  processingLockUntil          DateTime?                @map("processing_lock_until") @db.Timestamptz(3)
  unsignedXml                  String?                  @map("unsigned_xml") @db.Text
  signedXml                    String?                  @map("signed_xml") @db.Text
  authorizedXml                String?                  @map("authorized_xml") @db.Text
