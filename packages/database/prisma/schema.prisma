model ProfessionalService {
  membershipId          String     @map("membership_id") @db.Uuid
  serviceId             String     @map("service_id") @db.Uuid
  locationId            String     @map("location_id") @db.Uuid
  customDurationMinutes Int?       @map("custom_duration_minutes")
  customPriceCents      Int?       @map("custom_price_cents")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership            Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service               Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  location              Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipId, serviceId, locationId])
  @@index([serviceId, locationId])
  @@map("professional_services")
}

model BusinessWeeklySchedule {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  locationId     String       @map("location_id") @db.Uuid
  weekday        Int          @db.SmallInt
  isOpen         Boolean      @default(true) @map("is_open")
  startMinute    Int          @map("start_minute") @db.SmallInt
  endMinute      Int          @map("end_minute") @db.SmallInt
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, weekday])
  @@index([organizationId, weekday])
  @@map("business_weekly_schedules")
}

model WeeklySchedule {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  locationId   String     @map("location_id") @db.Uuid
  weekday      Int
  startMinute  Int        @map("start_minute")
  endMinute    Int        @map("end_minute")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([membershipId, locationId, weekday, startMinute])
  @@index([locationId, weekday])
  @@map("weekly_schedules")
}

model ScheduleBlock {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  membershipId   String       @map("membership_id") @db.Uuid
  locationId     String       @map("location_id") @db.Uuid
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(3)
  reason         String?      @db.VarChar(240)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([membershipId, startsAt, endsAt])
  @@index([locationId, startsAt])
  @@map("schedule_blocks")
}

model CashRegisterSession {
  id                      String             @id @default(uuid()) @db.Uuid
  organizationId          String?            @map("organization_id") @db.Uuid
  ownerUserId             String             @map("owner_user_id") @db.Uuid
  locationId              String?            @map("location_id") @db.Uuid
  responsibleMembershipId String?            @map("responsible_membership_id") @db.Uuid
  responsibleName         String             @map("responsible_name") @db.VarChar(120)
  openingAmountCents      Int                @map("opening_amount_cents")
  status                  CashRegisterStatus @default(OPEN)
  openedAt                DateTime           @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt                DateTime?          @map("closed_at") @db.Timestamptz(3)
  expectedAmountCents     Int?               @map("expected_amount_cents")
  closingAmountCents      Int?               @map("closing_amount_cents")
  differenceCents         Int?               @map("difference_cents")
  closedByUserId          String?            @map("closed_by_user_id") @db.Uuid
  closingNote             String?            @map("closing_note") @db.VarChar(500)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  movements               CashMovement[]

  @@index([organizationId, status])
  @@index([ownerUserId, status])
  @@map("cash_register_sessions")
}

model CashMovement {
  id                       String              @id @default(uuid()) @db.Uuid
  cashRegisterSessionId    String              @map("cash_register_session_id") @db.Uuid
  type                     CashMovementType
  paymentMethod            PaymentMethod?      @map("payment_method")
  amountCents              Int                 @map("amount_cents")
  description              String              @db.VarChar(240)
  appointmentId            String?             @unique @map("appointment_id") @db.Uuid
  serviceId                String?             @map("service_id") @db.Uuid
  productId                String?             @map("product_id") @db.Uuid
  productQuantity          Int?                @map("product_quantity")
  professionalMembershipId String?             @map("professional_membership_id") @db.Uuid
  professionalNameSnapshot String?             @map("professional_name_snapshot") @db.VarChar(120)
  sellerMembershipId       String?             @map("seller_membership_id") @db.Uuid
  sellerNameSnapshot       String?             @map("seller_name_snapshot") @db.VarChar(120)
  recordedByNameSnapshot   String?             @map("recorded_by_name_snapshot") @db.VarChar(120)
  reversedAt               DateTime?           @map("reversed_at") @db.Timestamptz(3)
  reversedByUserId         String?             @map("reversed_by_user_id") @db.Uuid
  reversalReason           String?             @map("reversal_reason") @db.VarChar(240)
  createdByUserId          String              @map("created_by_user_id") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  cashRegisterSession      CashRegisterSession @relation(fields: [cashRegisterSessionId], references: [id], onDelete: Cascade)
  product                  Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements           StockMovement[]

  @@index([cashRegisterSessionId, createdAt])
  @@index([appointmentId])
  @@index([professionalMembershipId, serviceId])
  @@index([sellerMembershipId, createdAt])
  @@index([productId, createdAt])
  @@index([reversedAt])
  @@map("cash_movements")
}

model Product {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  name                 String              @db.VarChar(120)
  sku                  String?             @db.VarChar(80)
  barcode              String?             @db.VarChar(80)
  imageData            String?             @map("image_data") @db.Text
  costCents            Int                 @default(0) @map("cost_cents")
  salePriceCents       Int                 @map("sale_price_cents")
  currencyCode         String              @default("USD") @map("currency_code") @db.Char(3)
  stockTrackingEnabled Boolean             @default(true) @map("stock_tracking_enabled")
  minimumStock         Int                 @default(0) @map("minimum_stock")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory            LocationInventory[]
  stockMovements       StockMovement[]
  cashMovements        CashMovement[]
  orderItems           ProductOrderItem[]

  @@unique([organizationId, name])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, isActive])
  @@map("products")
}

model LocationInventory {
  locationId       String   @map("location_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([locationId, productId])
  @@index([productId, quantityOnHand])
  @@map("location_inventory")
}

model ProductOrder {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  locationId         String                    @map("location_id") @db.Uuid
  customerName       String                    @map("customer_name") @db.VarChar(120)
  customerPhone      String                    @map("customer_phone") @db.VarChar(32)
  customerEmail      String?                   @map("customer_email") @db.VarChar(254)
  status             ProductOrderStatus        @default(PENDING_PAYMENT)
  paymentMethod      ProductOrderPaymentMethod @map("payment_method")
  paymentReference   String?                   @map("payment_reference") @db.VarChar(100)
  paymentUrl         String?                   @map("payment_url") @db.Text
  paymentRequestedAt DateTime?                 @map("payment_requested_at") @db.Timestamptz(3)
  paidAt             DateTime?                 @map("paid_at") @db.Timestamptz(3)
  readyAt            DateTime?                 @map("ready_at") @db.Timestamptz(3)
  fulfilledAt        DateTime?                 @map("fulfilled_at") @db.Timestamptz(3)
  expiresAt          DateTime                  @map("expires_at") @db.Timestamptz(3)
  totalCents         Int                       @map("total_cents")
  currencyCode       String                    @default("USD") @map("currency_code") @db.Char(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location           Location                  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items              ProductOrderItem[]

  @@index([organizationId, status, createdAt])
  @@index([locationId, status, expiresAt])
  @@map("product_orders")
}

model ProductOrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  productName    String       @map("product_name") @db.VarChar(120)
  unitPriceCents Int          @map("unit_price_cents")
  quantity       Int
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order          ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("product_order_items")
}

model StockMovement {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  locationId        String            @map("location_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  cashMovementId    String?           @map("cash_movement_id") @db.Uuid
  type              StockMovementType
  direction         StockDirection
  quantity          Int
  resultingQuantity Int               @map("resulting_quantity")
  unitCostCents     Int?              @map("unit_cost_cents")
  notes             String?           @db.VarChar(500)
  createdByUserId   String            @map("created_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location          Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  cashMovement      CashMovement?     @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([locationId, productId, createdAt])
  @@index([cashMovementId])
  @@map("stock_movements")
}

model CommissionRule {
  id                       String             @id @default(uuid()) @db.Uuid
  organizationId           String             @map("organization_id") @db.Uuid
  professionalMembershipId String             @map("professional_membership_id") @db.Uuid
  serviceId                String?            @map("service_id") @db.Uuid
  type                     CommissionRuleType
  value                    Int
  priority                 Int                @default(0)
  isActive                 Boolean            @default(true) @map("is_active")
  effectiveFrom            DateTime           @map("effective_from") @db.Date
  effectiveTo              DateTime?          @map("effective_to") @db.Date
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, professionalMembershipId, isActive])
  @@index([serviceId, effectiveFrom])
  @@map("commission_rules")
}

model CommissionSettlement {
  id                       String                     @id @default(uuid()) @db.Uuid
  organizationId           String                     @map("organization_id") @db.Uuid
  professionalMembershipId String                     @map("professional_membership_id") @db.Uuid
  periodStart              DateTime                   @map("period_start") @db.Date
  periodEnd                DateTime                   @map("period_end") @db.Date
  grossGeneratedCents      Int                        @map("gross_generated_cents")
  commissionAmountCents    Int                        @map("commission_amount_cents")
  advanceDeductionCents    Int                        @default(0) @map("advance_deduction_cents")
  adjustmentCents          Int                        @default(0) @map("adjustment_cents")
  totalPayableCents        Int                        @map("total_payable_cents")
  status                   CommissionSettlementStatus @default(DRAFT)
  notes                    String?                    @db.VarChar(500)
  createdByUserId          String                     @map("created_by_user_id") @db.Uuid
  approvedAt               DateTime?                  @map("approved_at") @db.Timestamptz(3)
  approvedByUserId         String?                    @map("approved_by_user_id") @db.Uuid
  paidAt                   DateTime?                  @map("paid_at") @db.Timestamptz(3)
  paidByUserId             String?                    @map("paid_by_user_id") @db.Uuid
  paymentMethod            PaymentMethod?             @map("payment_method")
  paymentReference         String?                    @map("payment_reference") @db.VarChar(120)
  cashMovementId           String?                    @unique @map("cash_movement_id") @db.Uuid
  cancelledAt              DateTime?                  @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId        String?                    @map("cancelled_by_user_id") @db.Uuid
  cancellationReason       String?                    @map("cancellation_reason") @db.VarChar(240)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, professionalMembershipId, periodStart, periodEnd])
  @@index([organizationId, status, periodStart])
  @@map("commission_settlements")
}

model ProfessionalAdvance {
  id                       String                    @id @default(uuid()) @db.Uuid
  organizationId           String                    @map("organization_id") @db.Uuid
  professionalMembershipId String                    @map("professional_membership_id") @db.Uuid
  cashMovementId           String?                   @unique @map("cash_movement_id") @db.Uuid
  reversalCashMovementId   String?                   @unique @map("reversal_cash_movement_id") @db.Uuid
  originalAmountCents      Int                       @map("original_amount_cents")
  reservedAmountCents      Int                       @default(0) @map("reserved_amount_cents")
  deductedAmountCents      Int                       @default(0) @map("deducted_amount_cents")
  paymentMethod            PaymentMethod             @map("payment_method")
  reference                String?                   @db.VarChar(120)
  notes                    String?                   @db.VarChar(500)
  status                   ProfessionalAdvanceStatus @default(PENDING)
  occurredAt               DateTime                  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdByUserId          String                    @map("created_by_user_id") @db.Uuid
  reversedAt               DateTime?                 @map("reversed_at") @db.Timestamptz(3)
  reversedByUserId         String?                   @map("reversed_by_user_id") @db.Uuid
  reversalReason           String?                   @map("reversal_reason") @db.VarChar(240)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, professionalMembershipId, status, occurredAt])
  @@map("professional_advances")
}

model CommissionSettlementAdvance {
  id           String                  @id @default(uuid()) @db.Uuid
  settlementId String                  @map("settlement_id") @db.Uuid
  advanceId    String                  @map("advance_id") @db.Uuid
  amountCents  Int                     @map("amount_cents")
  status       SettlementAdvanceStatus @default(RESERVED)
  appliedAt    DateTime?               @map("applied_at") @db.Timestamptz(3)
  releasedAt   DateTime?               @map("released_at") @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([settlementId, advanceId])
  @@index([advanceId, status])
  @@map("commission_settlement_advances")
}

model CommissionEntry {
  id                       String                @id @default(uuid()) @db.Uuid
  organizationId           String                @map("organization_id") @db.Uuid
  locationId               String                @map("location_id") @db.Uuid
  professionalMembershipId String                @map("professional_membership_id") @db.Uuid
  appointmentId            String?               @map("appointment_id") @db.Uuid
  appointmentServiceId     String?               @unique @map("appointment_service_id") @db.Uuid
  cashMovementId           String?               @unique @map("cash_movement_id") @db.Uuid
  ruleId                   String?               @map("rule_id") @db.Uuid
  settlementId             String?               @map("settlement_id") @db.Uuid
  baseAmountCents          Int                   @map("base_amount_cents")
  commissionAmountCents    Int                   @map("commission_amount_cents")
  status                   CommissionEntryStatus @default(PENDING)
  calculationSnapshot      Json                  @map("calculation_snapshot")
  reversalOfEntryId        String?               @unique @map("reversal_of_entry_id") @db.Uuid
  occurredAt               DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, professionalMembershipId, status, createdAt])
  @@index([settlementId])
  @@map("commission_entries")
}

model Appointment {
  id                                String                   @id @default(uuid()) @db.Uuid
  organizationId                    String                   @map("organization_id") @db.Uuid
  locationId                        String                   @map("location_id") @db.Uuid
  professionalMembershipId          String                   @map("professional_membership_id") @db.Uuid
  clientId                          String?                  @map("client_id") @db.Uuid
  clientName                        String                   @map("client_name") @db.VarChar(120)
  clientPhone                       String?                  @map("client_phone") @db.VarChar(24)
  clientEmail                       String?                  @map("client_email") @db.VarChar(254)
  startsAt                          DateTime                 @map("starts_at") @db.Timestamptz(3)
  endsAt                            DateTime                 @map("ends_at") @db.Timestamptz(3)
  status                            AppointmentStatus        @default(SCHEDULED)
  paymentStatus                     AppointmentPaymentStatus @default(PENDING) @map("payment_status")
  paymentConfirmationRequestedAt    DateTime?                 @map("payment_confirmation_requested_at") @db.Timestamptz(3)
  paymentConfirmationRequestedByUserId String?                 @map("payment_confirmation_requested_by_user_id") @db.Uuid
  source                            AppointmentSource        @default(MANUAL)
  reservesSlot                      Boolean                  @default(true) @map("reserves_slot")
  notes                             String?                  @db.VarChar(500)
  cancellationReason                String?                  @map("cancellation_reason") @db.VarChar(240)
  cancelledAt                       DateTime?                @map("cancelled_at") @db.Timestamptz(3)
  policyAcceptedAt                  DateTime?                @map("policy_accepted_at") @db.Timestamptz(3)
  policyVersion                     Int?                     @map("policy_version")
  attendanceConfirmationRequestedAt DateTime?                @map("attendance_confirmation_requested_at") @db.Timestamptz(3)
  attendanceConfirmationDeadlineAt  DateTime?                @map("attendance_confirmation_deadline_at") @db.Timestamptz(3)
  attendanceConfirmedAt             DateTime?                @map("attendance_confirmed_at") @db.Timestamptz(3)
  verificationExpiresAt             DateTime?                @map("verification_expires_at") @db.Timestamptz(3)
  publicIdempotencyKeyHash          String?                  @map("public_idempotency_key_hash") @db.Char(64)
  createdByUserId                   String?                  @map("created_by_user_id") @db.Uuid
  updatedByUserId                   String?                  @map("updated_by_user_id") @db.Uuid
  createdAt                         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization                      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location                          Location                 @relation(fields: [locationId], references: [id], onDelete: Restrict)
  professional                      Membership               @relation(fields: [professionalMembershipId], references: [id], onDelete: Restrict)
  client                            Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy                         User?                    @relation("AppointmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy                         User?                    @relation("AppointmentUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  services                          AppointmentService[]
  events                            AppointmentEvent[]
  publicAccess                      PublicBookingAccess?
  review                            AppointmentReview?
  appNotifications                  AppNotification[]
  paymentAttempts                   PaymentAttempt[]

  @@unique([organizationId, publicIdempotencyKeyHash])
  @@index([organizationId, startsAt])
  @@index([locationId, startsAt])
  @@index([professionalMembershipId, startsAt])
  @@index([clientId, startsAt])
  @@index([organizationId, paymentStatus, paymentConfirmationRequestedAt])
  @@map("appointments")
}

model AppNotification {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  appointmentId  String?             @map("appointment_id") @db.Uuid
  type           AppNotificationType
  title          String              @db.VarChar(160)
  body           String              @db.VarChar(500)
  data           Json                @default("{}")
  readAt         DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("app_notifications")
}

model NotificationPreference {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  category    NotificationCategory
  pushEnabled Boolean              @default(true) @map("push_enabled")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model PublicBookingAccess {
  id                   String      @id @default(uuid()) @db.Uuid
  appointmentId        String      @unique @map("appointment_id") @db.Uuid
  verificationCodeHash String      @map("verification_code_hash") @db.Char(64)
  verificationAttempts Int         @default(0) @map("verification_attempts")
  managementTokenHash  String?     @unique @map("management_token_hash") @db.Char(64)
  reminderTokenHash    String?     @unique @map("reminder_token_hash") @db.Char(64)
  verifiedAt           DateTime?   @map("verified_at") @db.Timestamptz(3)
  managementExpiresAt  DateTime?   @map("management_expires_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  appointment          Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([verifiedAt, managementExpiresAt])
  @@map("public_booking_access")
}

model PaymentAttempt {
  id                        String              @id @default(uuid()) @db.Uuid
  organizationId            String              @map("organization_id") @db.Uuid
  locationId                String              @map("location_id") @db.Uuid
  appointmentId             String              @map("appointment_id") @db.Uuid
  provider                  String              @default("payphone") @db.VarChar(40)
  clientTransactionId       String              @unique @map("client_transaction_id") @db.VarChar(15)
  providerTransactionId     String?             @unique @map("provider_transaction_id") @db.VarChar(80)
  storeId                   String              @map("store_id") @db.VarChar(160)
  amountCents               Int                 @map("amount_cents")
  currencyCode              String              @default("USD") @map("currency_code") @db.Char(3)
  paymentUrl                String?             @map("payment_url") @db.Text
  status                    OnlinePaymentStatus @default(PENDING)
  expiresAt                 DateTime            @map("expires_at") @db.Timestamptz(3)
  approvedAt                DateTime?           @map("approved_at") @db.Timestamptz(3)
  providerPayload           Json?               @map("provider_payload")
  manuallyConfirmedAt       DateTime?           @map("manually_confirmed_at") @db.Timestamptz(3)
  manuallyConfirmedByUserId String?             @map("manually_confirmed_by_user_id") @db.Uuid
  manualConfirmationNote    String?             @map("manual_confirmation_note") @db.VarChar(500)
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization              Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location                  Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  appointment               Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  manuallyConfirmedBy       User?               @relation("PayphoneManualConfirmation", fields: [manuallyConfirmedByUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId, createdAt])
  @@index([organizationId, status, expiresAt])
  @@map("payment_attempts")
}

model AppointmentReview {
  id                       String       @id @default(uuid()) @db.Uuid
  appointmentId            String       @unique @map("appointment_id") @db.Uuid
  organizationId           String       @map("organization_id") @db.Uuid
  locationId               String       @map("location_id") @db.Uuid
  professionalMembershipId String       @map("professional_membership_id") @db.Uuid
  clientName               String       @map("client_name") @db.VarChar(120)
  rating                   Int          @db.SmallInt
  comment                  String?      @db.VarChar(1000)
  isVisible                Boolean      @default(true) @map("is_visible")
  hiddenAt                 DateTime?    @map("hidden_at") @db.Timestamptz(3)
  hiddenByUserId           String?      @map("hidden_by_user_id") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  appointment              Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location                 Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  professional             Membership   @relation(fields: [professionalMembershipId], references: [id], onDelete: Cascade)
  hiddenBy                 User?        @relation("ReviewHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, isVisible, createdAt])
  @@index([professionalMembershipId, isVisible, createdAt])
  @@map("appointment_reviews")
}

model AppointmentService {
  id              String      @id @default(uuid()) @db.Uuid
  appointmentId   String      @map("appointment_id") @db.Uuid
  serviceId       String      @map("service_id") @db.Uuid
  serviceName     String      @map("service_name") @db.VarChar(120)
  durationMinutes Int         @map("duration_minutes")
  priceCents      Int         @map("price_cents")
  sortOrder       Int         @default(0) @map("sort_order")
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

model AppointmentEvent {
  id             BigInt               @id @default(autoincrement())
  organizationId String               @map("organization_id") @db.Uuid
  locationId     String               @map("location_id") @db.Uuid
  appointmentId  String               @map("appointment_id") @db.Uuid
  actorUserId    String?              @map("actor_user_id") @db.Uuid
  type           AppointmentEventType
  payload        Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  appointment    Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor          User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, id])
  @@index([locationId, id])
  @@map("appointment_events")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  locationId     String?      @map("location_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  entityType     String       @map("entity_type") @db.VarChar(80)
  entityId       String       @map("entity_id") @db.Uuid
  action         String       @db.VarChar(80)
  beforeData     Json?        @map("before_data")
  afterData      Json?        @map("after_data")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
