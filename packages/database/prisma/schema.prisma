generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MANAGER
  RECEPTIONIST
  BARBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  FREE
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AppointmentStatus {
  PENDING_VERIFICATION
  SCHEDULED
  WAITING
  CONFIRMED
  AWAITING_CONFIRMATION
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum AppointmentPaymentStatus {
  PENDING
  PAID
}

enum AppointmentSource {
  MANUAL
  PUBLIC_BOOKING
  WALK_IN
}

enum UnconfirmedBookingAction {
  KEEP
  CANCEL
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE
  DEPOSIT
  OTHER_INCOME
  EXPENSE
  WITHDRAWAL
  PROFESSIONAL_ADVANCE
  PROFESSIONAL_ADVANCE_REVERSAL
  COMMISSION_SETTLEMENT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PayphoneEnvironment {
  TEST
  PRODUCTION
}

enum PayphoneConnectionStatus {
  REQUIRES_ATTENTION
  CONNECTED
  ERROR
}

enum OnlinePaymentStatus {
  PENDING
  APPROVED
  CANCELLED
  FAILED
  EXPIRED
}

enum PlatformPaymentConfigurationStatus {
  DISABLED
  READY
  ERROR
}

enum SubscriptionInvoiceStatus {
  OPEN
  PENDING
  PAID
  EXPIRED
  VOID
  REFUNDED
}

enum SubscriptionPaymentStatus {
  CREATED
  LINK_CREATED
  PENDING_PROVIDER
  APPROVED
  APPLIED
  REJECTED
  EXPIRED
  FAILED
  REFUNDED
  REVERSED
}

enum SriEnvironment {
  TEST
  PRODUCTION
}

enum SriTaxRegime {
  GENERAL
  RIMPE
  RIMPE_NEGOCIO_POPULAR
}

enum SriInvoiceStatus {
  PENDING
  GENERATED
  SIGNED
  RECEIVED
  PROCESSING
  AUTHORIZED
  NOT_AUTHORIZED
  ERROR
}

enum SriInvoiceDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// Estado de entrega del comprobante comercial temporal. No representa el
// estado fiscal de una factura SRI.
enum SubscriptionPaymentReceiptDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentProviderEventSource {
  WEBHOOK
  POLL
  RECONCILIATION
}

enum PaymentProviderValidationStatus {
  PENDING
  VERIFIED
  INVALID
  IGNORED
}

enum SubscriptionChangeKind {
  ACTIVATED
  RENEWED
  PLAN_CHANGED
  STATUS_CHANGED
  REFUNDED
  REVERSED
  MANUAL_RECONCILIATION
}

enum SubscriptionDiscountKind {
  TEMPORARY
  LIFETIME_CONTINUITY
}

enum SubscriptionDiscountGrantStatus {
  ACTIVE
  REVOKED
}

enum CommissionRuleType {
  SERVICE_PERCENTAGE
  SERVICE_FIXED
}

enum CommissionEntryStatus {
  PENDING
  APPROVED
  SETTLED
  REVERSED
}

enum CommissionSettlementStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum ProfessionalAdvanceStatus {
  PENDING
  PARTIALLY_DEDUCTED
  FULLY_DEDUCTED
  REVERSED
}

enum SettlementAdvanceStatus {
  RESERVED
  APPLIED
  RELEASED
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  LOSS
}

enum StockDirection {
  IN
  OUT
}

enum ProductOrderStatus {
  PENDING_PAYMENT
  RESERVED
  PAID
  READY_FOR_PICKUP
  FULFILLED
  EXPIRED
  CANCELLED
}

enum ProductOrderPaymentMethod {
  CARD
  TRANSFER
  PICKUP
}

enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CANCELLED
  STATUS_CHANGED
}

enum AppNotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
  PAYMENT_CONFIRMATION_REQUIRED
  CASH_REGISTER_CLOSED
  CASH_REGISTER_VARIANCE
  LOW_STOCK
  TEAM_MEMBER_ACCEPTED
  REVIEW_NEGATIVE
  SUBSCRIPTION_RENEWAL
}

enum NotificationCategory {
  AGENDA
  CASH
  INVENTORY
  TEAM
  REVIEWS
  SUBSCRIPTION
  BILLING
  SECURITY
}

enum RegistrationAccountType {
  BUSINESS
  PROFESSIONAL
}

enum OnboardingCollaboratorRole {
  BARBER
  ADMINISTRATOR
  CUSTOM
}

enum PlatformOperatorRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
  OPERATIONS
  READ_ONLY
}

enum PlatformSupportCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PlatformSupportCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING
  CLOSED
}

enum PlatformAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum PlatformPrivacyRequestType {
  DATA_EXPORT
  DELETION
}

enum PlatformPrivacyRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum PlatformOverrideKind {
  FEATURE
  LIMIT
}

enum PlatformConfigurationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                                   String                         @id @default(uuid()) @db.Uuid
  email                                String                         @unique @db.VarChar(254)
  passwordHash                         String?                        @map("password_hash") @db.Text
  fullName                             String                         @map("full_name") @db.VarChar(120)
  phone                                String?                        @db.VarChar(24)
  profilePhotoData                     String?                        @map("profile_photo_data") @db.Text
  profileBio                           String?                        @map("profile_bio") @db.VarChar(500)
  emailVerifiedAt                      DateTime?                      @map("email_verified_at") @db.Timestamptz(3)
  suspendedAt                          DateTime?                      @map("suspended_at") @db.Timestamptz(3)
  locale                               String                         @default("es") @db.VarChar(10)
  deletedAt                            DateTime?                      @map("deleted_at") @db.Timestamptz(3)
  createdAt                            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                            DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                             Session[]
  platformAccessChallenges             PlatformAdminAccessChallenge[]
  passwordResetTokens                  PasswordResetToken[]
  emailVerificationCodes               EmailVerificationCode[]
  memberships                          Membership[]
  auditLogs                            AuditLog[]                     @relation("AuditActor")
  invitationsSent                      TeamInvitation[]               @relation("InvitationInviter")
  appointmentsCreated                  Appointment[]                  @relation("AppointmentCreator")
  appointmentsUpdated                  Appointment[]                  @relation("AppointmentUpdater")
  appointmentEvents                    AppointmentEvent[]
  registrationProfile                  UserRegistrationProfile?
  onboardingCollaborators              OnboardingCollaborator[]
  onboardingServices                   OnboardingService[]
  clientsCreated                       Client[]                       @relation("ClientCreator")
  clientsUpdated                       Client[]                       @relation("ClientUpdater")
  clientNotesCreated                   ClientNote[]                   @relation("ClientNoteCreator")
  clientLabelsCreated                  ClientLabel[]                  @relation("ClientLabelCreator")
  clientLabelsUpdated                  ClientLabel[]                  @relation("ClientLabelUpdater")
  reviewsHidden                        AppointmentReview[]            @relation("ReviewHiddenBy")
  portfolioItems                       UserPortfolioItem[]
  appNotifications                     AppNotification[]
  notificationPreferences              NotificationPreference[]
  pushTokens                           PushToken[]
  payphoneManualConfirmations          PaymentAttempt[]               @relation("PayphoneManualConfirmation")
  platformOperator                     PlatformOperator?              @relation("PlatformOperatorUser")
  platformOperatorsCreated             PlatformOperator[]             @relation("PlatformOperatorCreator")
  platformSupportCasesCreated          PlatformSupportCase[]          @relation("PlatformSupportCaseCreator")
  platformSupportCasesAssigned         PlatformSupportCase[]          @relation("PlatformSupportCaseAssignee")
  platformSupportCaseEvents            PlatformSupportCaseEvent[]     @relation("PlatformSupportCaseEventActor")
  platformAuditLogs                    PlatformAuditLog[]             @relation("PlatformAuditActor")
  platformAlertsActedOn                PlatformAlert[]                @relation("PlatformAlertActor")
  platformExports                      PlatformExport[]               @relation("PlatformExportRequester")
  platformPrivacySubjects              PlatformPrivacyRequest[]       @relation("PlatformPrivacySubject")
  platformPrivacyCreated               PlatformPrivacyRequest[]       @relation("PlatformPrivacyCreator")
  platformPrivacyAssigned              PlatformPrivacyRequest[]       @relation("PlatformPrivacyAssignee")
  platformOverridesCreated             PlatformFeatureOverride[]      @relation("PlatformOverrideCreator")
  platformOverridesRevoked             PlatformFeatureOverride[]      @relation("PlatformOverrideRevoker")
  platformOrganizationNotes            PlatformOrganizationNote[]     @relation("PlatformOrganizationNoteCreator")
  platformConfigurationsCreated        PlatformConfigurationVersion[] @relation("PlatformConfigurationCreator")
  platformConfigurationsApproved       PlatformConfigurationVersion[] @relation("PlatformConfigurationApprover")
  subscriptionInvoicesRequested        SubscriptionInvoice[]          @relation("SubscriptionInvoiceRequester")
  subscriptionPaymentAttemptsInitiated SubscriptionPaymentAttempt[]   @relation("SubscriptionPaymentInitiator")
  subscriptionChangesActed             SubscriptionChange[]           @relation("SubscriptionChangeActor")
  subscriptionDiscountCouponsCreated   SubscriptionDiscountCoupon[]   @relation("SubscriptionDiscountCouponCreator")
  subscriptionDiscountGrantsRedeemed   SubscriptionDiscountGrant[]    @relation("SubscriptionDiscountGrantRedeemer")
  subscriptionDiscountGrantsRevoked    SubscriptionDiscountGrant[]    @relation("SubscriptionDiscountGrantRevoker")
  marketingConsents                    MarketingConsent[]
  privacyConsents                      PrivacyConsent[]
  welcomeSurveyResponse                WelcomeSurveyResponse?

  @@index([deletedAt])
  @@index([suspendedAt])
  @@map("users")
}

model WelcomeSurveyResponse {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  selectedOptions String[] @map("selected_options") @db.VarChar(120)
  submittedAt     DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submittedAt])
  @@map("welcome_survey_responses")
}

model AccountDeletionRetention {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  identifierHash String   @unique @map("identifier_hash") @db.Char(64)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([userId])
  @@map("account_deletion_retentions")
}

model UserPortfolioItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  photoData String   @map("photo_data") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_portfolio_items")
}

model EmailVerificationCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_codes")
}

model PendingRegistration {
  id              String                   @id @default(uuid()) @db.Uuid
  email           String                   @unique @db.VarChar(254)
  fullName        String                   @map("full_name") @db.VarChar(120)
  passwordHash    String                   @map("password_hash") @db.Text
  codeHash        String                   @map("code_hash") @db.Char(64)
  expiresAt       DateTime                 @map("expires_at") @db.Timestamptz(3)
  failedAttempts  Int                      @default(0) @map("failed_attempts")
  lockedUntil     DateTime?                @map("locked_until") @db.Timestamptz(3)
  accountType     RegistrationAccountType? @map("account_type")
  businessName    String?                  @map("business_name") @db.VarChar(120)
  businessNameKey String?                  @map("business_name_key") @db.VarChar(120)
  phone           String?                  @db.VarChar(24)
  phoneKey        String?                  @unique @map("phone_key") @db.VarChar(24)
  countryCode     String?                  @map("country_code") @db.Char(2)
  city            String?                  @db.VarChar(120)
  timezone        String?                  @db.VarChar(64)
  openingTime     String?                  @map("opening_time") @db.Char(5)
  closingTime     String?                  @map("closing_time") @db.Char(5)
  marketingOptIn  Boolean                  @default(false) @map("marketing_opt_in")
  privacyPolicyAccepted Boolean             @default(false) @map("privacy_policy_accepted")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([lockedUntil])
  @@map("pending_registrations")
}

model MarketingConsent {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  policyVersion String    @map("policy_version") @db.VarChar(80)
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  withdrawnAt   DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, withdrawnAt])
  @@map("marketing_consents")
}

model PrivacyConsent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  policyVersion String   @map("policy_version") @db.VarChar(80)
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, acceptedAt])
  @@map("privacy_consents")
}

model UserRegistrationProfile {
  userId                String                  @id @map("user_id") @db.Uuid
  accountType           RegistrationAccountType @map("account_type")
  businessName          String                  @map("business_name") @db.VarChar(120)
  businessNameKey       String                  @map("business_name_key") @db.VarChar(120)
  countryCode           String                  @map("country_code") @db.Char(2)
  city                  String                  @db.VarChar(120)
  timezone              String                  @default("America/Guayaquil") @db.VarChar(64)
  addressLine           String?                 @map("address_line") @db.VarChar(240)
  // Las portadas se guardan como data URI comprimida durante el piloto. TEXT
  // evita truncar el contenido base64 y no requiere un proveedor externo.
  coverImageUri         String?                 @map("cover_image_uri") @db.Text
  description           String?                 @db.VarChar(500)
  facebookUrl           String?                 @map("facebook_url") @db.VarChar(2048)
  instagramUrl          String?                 @map("instagram_url") @db.VarChar(2048)
  openingTime           String                  @map("opening_time") @db.Char(5)
  closingTime           String                  @map("closing_time") @db.Char(5)
  phoneKey              String                  @unique @map("phone_key") @db.VarChar(24)
  onboardingCompletedAt DateTime?               @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_registration_profiles")
}

model OnboardingCollaborator {
  id                    String                     @id @default(uuid()) @db.Uuid
  ownerUserId           String                     @map("owner_user_id") @db.Uuid
  name                  String                     @db.VarChar(120)
  invitationEmail       String?                    @map("invitation_email") @db.VarChar(254)
  commissionPercentage  Int?                       @map("commission_percentage") @db.SmallInt
  description           String?                    @db.VarChar(500)
  photoUri              String?                    @map("photo_uri") @db.VarChar(2048)
  role                  OnboardingCollaboratorRole
  customRoleName        String?                    @map("custom_role_name") @db.VarChar(80)
  customRoleDescription String?                    @map("custom_role_description") @db.VarChar(500)
  canPerformServices    Boolean                    @default(false) @map("can_perform_services")
  identification        String?                    @db.VarChar(64)
  phone                 String?                    @db.VarChar(24)
  agendaColor           String                     @default("#2464E8") @map("agenda_color") @db.Char(7)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                 User                       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@map("onboarding_collaborators")
}

model OnboardingService {
  id                    String   @id @default(uuid()) @db.Uuid
  ownerUserId           String   @map("owner_user_id") @db.Uuid
  name                  String   @db.VarChar(120)
  description           String?  @db.VarChar(500)
  durationMinutes       Int      @map("duration_minutes")
  priceCents            Int      @map("price_cents")
  priceType             String   @map("price_type") @db.VarChar(16)
  onlineBooking         Boolean  @default(true) @map("online_booking")
  showServiceTime       Boolean  @default(true) @map("show_service_time")
  categoryName          String?  @map("category_name") @db.VarChar(80)
  categoryDescription   String?  @map("category_description") @db.VarChar(500)
  taxName               String?  @map("tax_name") @db.VarChar(80)
  taxPercentage         Int?     @map("tax_percentage")
  taxAddAtCheckout      Boolean  @default(false) @map("tax_add_at_checkout")
  taxAddAtPurchaseEnd   Boolean  @default(false) @map("tax_add_at_purchase_end")
  imageUri              String?  @map("image_uri") @db.VarChar(2048)
  agendaColor           String   @map("agenda_color") @db.Char(7)
  downPaymentPercentage Int      @default(0) @map("down_payment_percentage")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                 User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@map("onboarding_services")
}

model Session {
  id                       String                         @id @default(uuid()) @db.Uuid
  userId                   String                         @map("user_id") @db.Uuid
  tokenHash                String                         @unique @map("token_hash") @db.Char(64)
  expiresAt                DateTime                       @map("expires_at") @db.Timestamptz(3)
  lastActiveAt             DateTime                       @default(now()) @map("last_active_at") @db.Timestamptz(3)
  revokedAt                DateTime?                      @map("revoked_at") @db.Timestamptz(3)
  createdAt                DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  user                     User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformAccessChallenges PlatformAdminAccessChallenge[]

  @@index([userId, expiresAt])
  @@index([lastActiveAt])
  @@map("sessions")
}

model PlatformAdminAccessChallenge {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  sessionId          String?   @map("session_id") @db.Uuid
  challengeTokenHash String?   @unique @map("challenge_token_hash") @db.Char(64)
  codeHash           String    @map("code_hash") @db.Char(64)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(3)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  failedAttempts     Int       @default(0) @map("failed_attempts")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session            Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, verifiedAt])
  @@index([userId, expiresAt])
  @@map("platform_admin_access_challenges")
}

model PlatformOperator {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @unique @map("user_id") @db.Uuid
  role                 PlatformOperatorRole @default(READ_ONLY)
  isActive             Boolean              @default(true) @map("is_active")
  adminPasswordHash    String?              @map("admin_password_hash") @db.Text
  adminPasswordSetAt   DateTime?            @map("admin_password_set_at") @db.Timestamptz(3)
  createdByUserId      String?              @map("created_by_user_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User                 @relation("PlatformOperatorUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy            User?                @relation("PlatformOperatorCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([isActive, role])
  @@map("platform_operators")
}

model PlatformSupportCase {
  id               String                      @id @default(uuid()) @db.Uuid
  organizationId   String                      @map("organization_id") @db.Uuid
  title            String                      @db.VarChar(160)
  category         String                      @db.VarChar(60)
  description      String                      @db.VarChar(2000)
  priority         PlatformSupportCasePriority @default(MEDIUM)
  status           PlatformSupportCaseStatus   @default(OPEN)
  createdByUserId  String?                     @map("created_by_user_id") @db.Uuid
  assignedToUserId String?                     @map("assigned_to_user_id") @db.Uuid
  slaDueAt         DateTime?                   @map("sla_due_at") @db.Timestamptz(3)
  closedAt         DateTime?                   @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy        User?                       @relation("PlatformSupportCaseCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo       User?                       @relation("PlatformSupportCaseAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  events           PlatformSupportCaseEvent[]

  @@index([organizationId, status, updatedAt])
  @@index([assignedToUserId, status])
  @@map("platform_support_cases")
}

model PlatformSupportCaseEvent {
  id          String              @id @default(uuid()) @db.Uuid
  caseId      String              @map("case_id") @db.Uuid
  actorUserId String?             @map("actor_user_id") @db.Uuid
  type        String              @db.VarChar(60)
  note        String?             @db.VarChar(2000)
  metadata    Json                @default("{}")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  supportCase PlatformSupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor       User?               @relation("PlatformSupportCaseEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("platform_support_case_events")
}

model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.VarChar(120)
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?    @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

