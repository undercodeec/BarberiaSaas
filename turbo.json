{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "EXPO_NO_TELEMETRY",
    "EXPO_PUBLIC_API_ALLOWED_HOSTS",
    "EXPO_PUBLIC_APP_ENV",
    "EXPO_PUBLIC_API_URL",
    "TEST_DATABASE_URL",
    "__UNSAFE_EXPO_HOME_DIRECTORY"
  ],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
