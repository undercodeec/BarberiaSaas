{
  "expo": {
    "name": "Barbería",
    "slug": "barber-saas-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "barbersaas",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite que Nava tome fotos para las notas de clientes.",
          "photosPermission": "Permite que Nava agregue fotos a las notas de clientes."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permite que Nava importe tus contactos para crear reservas m?s r?pido."
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "web": { "bundler": "metro" },
    "android": {
      "package": "com.barbersaas.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "ios": { "bundleIdentifier": "com.barbersaas.mobile" },
    "extra": {
      "router": {},
      "eas": { "projectId": "0feb8bfa-2e01-44e6-8e79-22927a8a7dcb" }
    },
    "owner": "undercodeec"
  }
}
