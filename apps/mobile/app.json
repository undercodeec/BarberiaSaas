{
  "expo": {
    "name": "Nava",
    "slug": "barber-saas-mobile",
    "version": "0.1.0",
    "runtimeVersion": "0.1.0",
    "icon": "./assets/icon.png",
    "updates": {
      "url": "https://u.expo.dev/0feb8bfa-2e01-44e6-8e79-22927a8a7dcb"
    },
    "orientation": "portrait",
    "scheme": "barbersaas",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite que Nava tome fotos para las notas de clientes.",
          "photosPermission": "Permite que Nava agregue fotos a las notas de clientes."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permite que Nava importe tus contactos para crear reservas más rápido."
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "web": { "bundler": "metro" },
    "android": {
      "package": "com.barbersaas.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS"
      ]
    },
    "ios": { "bundleIdentifier": "com.barbersaas.mobile" },
    "extra": {
      "router": {},
      "eas": { "projectId": "0feb8bfa-2e01-44e6-8e79-22927a8a7dcb" }
    },
    "owner": "undercodeec"
  }
}
