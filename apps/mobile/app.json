{
  "expo": {
    "name": "Nava",
    "slug": "barber-saas-mobile",
    "version": "0.1.17",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "barbersaas",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/cash_income.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite que Nava tome fotos para las notas de clientes.",
          "photosPermission": "Permite que Nava agregue fotos a las notas de clientes."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permite que Nava importe tus contactos para crear reservas más rápido."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "android": {
      "allowBackup": false,
      "versionCode": 39,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.WRITE_CONTACTS",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.barbersaas.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "host": "reservas.navacloud.app",
              "path": "/accept-invitation",
              "scheme": "https"
            },
            {
              "host": "reservas.navacloud.app",
              "path": "/reset-password",
              "scheme": "https"
            }
          ]
        }
      ],
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS"
      ]
    },
    "ios": {
      "associatedDomains": [
        "applinks:reservas.navacloud.app"
      ],
      "bundleIdentifier": "app.navacloud.nava",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48601b21-85b7-4e00-92a5-75c361644bc2"
      }
    },
    "owner": "undercodeecs-team"
  }
}
