{
  "name": "@barber-saas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm --filter @barber-saas/database db:generate"
  },
  "dependencies": {
    "@barber-saas/database": "workspace:*",
    "@barber-saas/permissions": "workspace:*",
    "@barber-saas/validation": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
