{
  "name": "@barber-saas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && node scripts/copy-sri-schemas.mjs",
    "dev": "tsx watch src/index.ts",
    "password:hash": "tsx src/generate-password-hash.ts",
    "platform:operator:password": "tsx src/configure-platform-operator-password.ts",
    "start": "node dist/index.js",
    "payphone:platform:configure": "tsx src/configure-platform-payphone.ts",
    "sri:certificate:check": "tsx src/inspect-sri-certificate.ts",
    "test": "vitest run --passWithNoTests --no-file-parallelism --pool=forks --testTimeout=20000",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm --filter @barber-saas/database db:generate"
  },
  "dependencies": {
    "@barber-saas/database": "workspace:*",
    "@barber-saas/permissions": "workspace:*",
    "@barber-saas/validation": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@prisma/client": "7.8.0",
    "@xmldom/xmldom": "0.8.11",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "google-auth-library": "11.0.2",
    "libxmljs2": "0.37.0",
    "node-forge": "1.4.0",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "xadesjs": "2.6.8",
    "xpath": "0.0.34",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/node-forge": "1.3.14",
    "@types/nodemailer": "8.0.1",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
